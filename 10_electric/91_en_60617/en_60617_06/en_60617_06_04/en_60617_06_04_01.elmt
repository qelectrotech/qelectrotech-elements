    <uuid uuid="{c8308dfd-83c1-fed8-0e20-412fde96dde6}"/>
    <names>
        <name lang="ar">آلة، رمز عام (استبدل "*" بالتعيين):
C محول دوار
G مولد
GS مولد متزامن
M محرك
MG آلة صالحة للاستخدام كمحرك أو مولد
MS محرك متزامن</name>
        <name lang="ca"></name>
        <name lang="ca"></name>
        <name lang="cs">Stroj, všeobecná značka:
C rotační měnič
G generátor
GS Synchronní alternátor
M motor
MG motor/synchrogenerátor
MS synchronní motor</name>
        <name lang="da">Maskine, generelt symbol (erstat "*" med betegnelse):
C Roterende omformer
G Generator
GS Synkrongenerator
M Motor
MG Maskine, der kan bruges som motor eller generator
MS Synkronmotor</name>
        <name lang="de">Maschine, allgemein (Asterisk "*" ersetzen durch):
C Rotierender Umformer
G Generator
GS Synchrongenerator
M Motor
MG Motor/Generator
MS Synchronmotor</name>
        <name lang="el">Μηχανή, γενικό σύμβολο (αντικαταστήστε το "*" με χαρακτηρισμό):
C Μετατροπέας περιστροφής
G Γεννήτρια
GS Σύγχρονη γεννήτρια
M Κινητήρας
MG Μηχανή κατάλληλη για χρήση ως κινητήρας ή γεννήτρια
MS Σύγχρονος κινητήρας</name>
        <name lang="en">Machine, general symbol (replace "*" by designation):
C Rotary converter
G Generator
GS Synchronous generator
M Motor
MG Machine capable of use as a motor or generator
MS Synchronous motor</name>
        <name lang="es">Máquina, símbolo general (sustituir "*" por la designación):
C Convertidor rotativo
G Generador
GS Generador síncrono
M Motor
MG Máquina que puede usarse como motor o generador
MS Motor síncrono</name>
        <name lang="fi">Kone, yleissymboli (korvaa "*" tunnuksella):
C Pyörivä muunnin
G Generaattori
GS Tahtigeneraattori
M Moottori
MG Kone, jota voidaan käyttää moottorina tai generaattorina
MS Tahtimoottori</name>
        <name lang="fr">Machine, par example (au lieu de
l’astérisque):
C Commutatrice
G Génératrice
GS Alternateur synchrone
M Moteur
MG Moteur/génératrice
MS Moteur synchrone</name>
        <name lang="hr">Stroj, opći simbol (zamijenite "*" oznakom):
C Rotacijski pretvarač
G Generator
GS Sinkroni generator
M Motor
MG Stroj koji se može koristiti kao motor ili generator
MS Sinkroni motor</name>
        <name lang="hu">Gép, általános szimbólum (a "*"-ot helyettesítse a jelöléssel):
C Forgógép
G Generátor
GS Szinkrongenerátor
M Motor
MG Motor vagy generátorként használható gép
MS Szinkronmotor</name>
        <name lang="it">Macchina, simbolo generale (sostituire "*" con la designazione):
C Convertitore rotante
G Generatore
GS Generatore sincrono
M Motore
MG Macchina utilizzabile come motore o generatore
MS Motore sincrono</name>
        <name lang="ja">機械、一般図記号（"*"を次の呼称に置き換える）：
C 回転変流機
G 発電機
GS 同期発電機
M 電動機
MG 電動機又は発電機として使用可能な機械
MS 同期電動機</name>
        <name lang="ko">기계, 일반 기호 ("*"를 지정으로 대체):
C 회전 변환기
G 발전기
GS 동기 발전기
M 모터
MG 모터 또는 발전기로 사용 가능한 기계
MS 동기 모터</name>
        <name lang="mn">Машин, ерөнхий тэмдэглэгээ ("*"-г тэмдэглэгээгээр солино):
C Эргэдэг хөрвүүлэгч
G Генератор
GS Синхрон генератор
M Мотор
MG Мотор эсвэл генератор болгон ашиглах боломжтой машин
MS Синхрон мотор</name>
        <name lang="nb">Maskin, generelt symbol (erstatt "*" med betegnelse):
C Roterende omformer
G Generator
GS Synkrongenerator
M Motor
MG Maskin som kan brukes som motor eller generator
MS Synkronmotor</name>
        <name lang="nl">Machine, algemeen symbool (vervang "*" door aanduiding):
C Roterende omvormer
G Generator
GS Synchrone generator
M Motor
MG Machine bruikbaar als motor of generator
MS Synchrone motor</name>
        <name lang="nl_BE">Machine, algemeen symbool (vervang "*" door aanduiding):
C Omvormer
G Generator
GS Synchrone generator
M Motor
MG Machine bruikbaar als motor of generator
MS Synchrone motor</name>
        <name lang="pl">Maszyna, symbol ogólny (zamiast "*" wstaw oznaczenie):
C Przekształtnik obrotowy
G Generator
GS Generator synchroniczny
M Silnik
MG Maszyna mogąca pracować jako silnik lub generator
MS Silnik synchroniczny</name>
        <name lang="pt">Máquina, símbolo geral (substituir "*" pela designação):
C Conversor rotativo
G Gerador
GS Gerador síncrono
M Motor
MG Máquina utilizável como motor ou gerador
MS Motor síncrono</name>
        <name lang="ro">Mașină, simbol general (înlocuiți "*" cu repere):
C Convertizor rotativ
G Generator
GS Generator sincron
M Motor
MG Mașină utilizabilă ca motor sau generator
MS Motor sincron</name>
        <name lang="ru">Машина, общее обозначение (замените "*" на обозначение):
C Вращающийся преобразователь
G Генератор
GS Синхронный генератор
M Двигатель
MG Машина, способная работать как двигатель или генератор
MS Синхронный двигатель</name>
        <name lang="sk">Stroj, všeobecná značka (nahraďte "*" označením):
C Rotačný menič
G Generátor
GS Synchrónny generátor
M Motor
MG Stroj použiteľný ako motor alebo generátor
MS Synchrónny motor</name>
        <name lang="sl">Stroj, splošni simbol (zamenjajte "*" z oznako):
C Vrtljivi pretvornik
G Generator
GS Sinhronski generator
M Motor
MG Stroj, ki se lahko uporablja kot motor ali generator
MS Sinhronski motor</name>
        <name lang="sr">Машина, општи симбол (замените "*" ознаком):
C Ротациони конвертор
G Генератор
GS Синхрони генератор
M Мотор
MG Машина која може да се користи као мотор или генератор
MS Синхрони мотор</name>
        <name lang="sv">Maskin, allmän symbol (ersätt "*" med beteckning):
C Roterande omformare
G Generator
GS Synkrongenerator
M Motor
MG Maskin som kan användas som motor eller generator
MS Synkronmotor</name>
        <name lang="tr">Makine, genel sembol ("*" yerine tanımlama yazın):
C Döner konvertör
G Jeneratör
GS Senkron jeneratör
M Motor
MG Motor veya jeneratör olarak kullanılabilen makine
MS Senkron motor</name>
        <name lang="uk">Машина, загальне позначення (замініть "*" на позначення):
C Обертовий перетворювач
G Генератор
GS Синхронний генератор
M Двигун
MG Машина, здатна працювати як двигун або генератор
MS Синхронний двигун</name>
        <name lang="zh">接线端子01</name>
    
          <name lang="pt_BR">Máquina, símbolo geral</name>
    </names>
