        <elementInformation name="quantity" show="1">1</elementInformation>
        <elementInformation name="supplier" show="1">Shelly Europe Ltd.</elementInformation>
        <elementInformation name="unity" show="1">1</elementInformation>
    </elementInformations>
    <informations>Shelly Europe Ltd.</informations>
