    <elementInformations>
        <elementInformation name="description" show="1">Smart dimming controller for seamless remote control of dimmable lights and drivers. It can be used with or without a neutral wire. Equipped with our own Shelly chip.</elementInformation>
        <elementInformation name="designation" show="1">Shelly Dimmer Gen3</elementInformation>
        <elementInformation name="manufacturer" show="1">Shelly Europe Ltd.</elementInformation>
