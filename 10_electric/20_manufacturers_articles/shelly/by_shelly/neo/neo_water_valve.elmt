    <elementInformations>
        <elementInformation name="comment" show="1">Neo Smart Water Valve NAS-WV02W</elementInformation>
        <elementInformation name="description" show="1">NSF-certified smart DN25 brass valve for drinking water systems. Delivers precise ultrasonic measurement, water consumption tracking, automatic shut-off/on, and Shelly app control via Wi-Fi and Bluetooth.</elementInformation>
